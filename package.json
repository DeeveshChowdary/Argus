{
  "name": "argus-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "test": "node --test --test-timeout=30000",
    "check": "node --check src/index.js && node --check src/worker.js && node --check public/app.js && node --check scripts/smoke.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "miniflare": "4.20260730.0",
    "wrangler": "4.135.0"
  }
}
