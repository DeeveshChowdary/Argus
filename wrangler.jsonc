{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argus-foundation",
  "account_id": "45043f37f988b1d90a57e97c57e549d5",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/health/*", "/api/*"]
  },
  "vars": { "APP_ENV": "production", "MARKET_SCAN_ENABLED": "true" },
  "secrets": { "required": ["APCA_API_KEY_ID", "APCA_API_SECRET_KEY"] },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "argus-foundation-db",
    "database_id": "7643ebbc-df97-4986-87c5-7a924cd1b414",
    "migrations_dir": "migrations"
  }]
}
